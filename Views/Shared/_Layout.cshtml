<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoredProcedureActions</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StoredProcedureActions.styles.css" asp-append-version="true" />
    <style>
        /* Minimal AdminLTE-like layout styles */
        body.adminlte {
            display: flex;
            min-height: 100vh;
            flex-direction: row;
            background-color: #f4f6f9;
        }
        .main-sidebar {
            width: 250px;
            background: #343a40;
            color: #fff;
            min-height: 100vh;
            padding-top: 1rem;
        }
        .brand-link {
            font-weight: 600;
            color: #fff;
            padding: .5rem 1rem;
            display: block;
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.9);
        }
        .content-wrapper {
            flex: 1 1 auto;
            padding: 1.5rem;
        }
        .topbar {
            height: 56px;
            background: #fff;
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding: 0 .75rem;
            border-bottom: 1px solid #dee2e6;
        }
        .profile-img {
            width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid #fff;
        }
        /* theme toggle removed - animations will be used instead */

        /* Dark mode */
        body.dark-mode { background: #1f2937; color: #e5e7eb; }
        body.dark-mode .main-sidebar { background:#111827 }
        body.dark-mode .topbar { background:#0b1220; border-bottom-color:#111827 }
        body.dark-mode .content-wrapper { background:transparent }
        body.dark-mode .sidebar .nav-link { color: #d1d5db }
        body.dark-mode .brand-link { color:#fff }

        @@media (max-width: 767px) {
            .main-sidebar { position: fixed; z-index:1050; left:-260px; transition: left .2s }
            .main-sidebar.open { left:0 }
            body.adminlte { flex-direction: column }
            .content-wrapper { padding-top: 1rem }
        }
    </style>
</head>
<body class="adminlte">
    <div class="main-sidebar">
        <div class="sidebar-header text-center py-4">
            <a class="brand-link d-flex align-items-center justify-content-center" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">SP</div>
                <div class="brand-text ms-2">Stored Procedure</div>
            </a>
        </div>

        <nav class="sidebar px-2">
            <h6 class="sidebar-section">NAVIGATION</h6>
            <ul class="nav flex-column mb-3">
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center" asp-area="" asp-controller="StoredProcedure" asp-action="Index"><i class="bi bi-grid-fill me-2"></i><span>Stored Procedures</span></a>
                </li>
            </ul>
        </nav>
    </div>

    <div class="content-wrapper">
        <div class="topbar mb-3">
            <div style="display:flex;align-items:center;gap:1rem">
                <button id="sidebarToggle" class="btn btn-sm btn-outline-secondary d-md-none">☰</button>
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div style="display:flex;align-items:center;gap:1rem">
                <div class="profile d-flex align-items-center">
                    <img class="profile-img" src="https://images.pexels.com/photos/415829/pexels-photo-415829.jpeg?auto=compress&cs=tinysrgb&dpr=1&w=100" alt="Profile" />
                </div>
            </div>
        </div>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted mt-4" style="padding-top:1rem">
            <div>
                &copy; 2024 - StoredProcedureActions - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.2/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@studio-freight/lenis@1.0.36/bundled/lenis.min.js"></script>

    <script>
        (function(){
            // Initialize Lenis (smooth scrolling) and GSAP animations
            (function(){
                // Load Lenis and GSAP from CDN
                // Lenis: smooth scrolling
                try {
                    if (typeof Lenis !== 'undefined') {
                        const lenis = new Lenis({ duration: 1.2, smooth: true });
                        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
                        requestAnimationFrame(raf);
                    }
                } catch (e) { console && console.warn('Lenis init failed', e); }

                // GSAP animations for initial card reveal
                try {
                    if (typeof gsap !== 'undefined') {
                        gsap.from('.card', { opacity: 0, y: 18, duration: 0.6, stagger: 0.06, ease: 'power2.out' });
                        gsap.from('.brand-icon', { scale: 0, duration: 0.6, ease: 'back.out(1.7)' });
                    }
                } catch (e) { console && console.warn('GSAP init failed', e); }

                // mobile sidebar toggle
                var sidebar = document.querySelector('.main-sidebar');
                var btn = document.getElementById('sidebarToggle');
                btn && btn.addEventListener('click', function(){
                    sidebar && sidebar.classList.toggle('open');
                });
            })();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
