@model List<StoredProcedureActions.Models.StoredProcedureParameter>

@if (Model.Any())
{
    <div class="mb-2"><strong>Parameters</strong></div>
    <div class="row g-2">
        @foreach (var param in Model)
        {
            string inputType = "text";
            string stepValue = null;

            if (param.DataType.Contains("Date"))
            {
                inputType = "date";
            }
            else if (param.DataType.Contains("Int"))
            {
                inputType = "number";
            }
            else if (param.DataType.Contains("Decimal") || param.DataType.Contains("Float") || param.DataType.Contains("Money"))
            {
                inputType = "number";
                stepValue = "0.01";
            }
            else if (param.DataType.Contains("Bit"))
            {
                inputType = "checkbox";
            }

            <div class="col-12">
                <label class="form-label">@param.Name <small class="text-muted">@param.DataType</small></label>
                @if (inputType == "checkbox")
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true" name="paramValues[@param.Name]" />
                        <label class="form-check-label">True/False</label>
                    </div>
                }
                else
                {
                    <input type="@inputType" name="paramValues[@param.Name]" class="form-control" step="@stepValue" />
                }
            </div>
        }
    </div>
}
else
{
    <p class="text-danger">No parameters available for this stored procedure.</p>
}
